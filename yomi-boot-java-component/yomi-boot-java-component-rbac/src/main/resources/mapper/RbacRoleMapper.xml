<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yomi.boot.java.component.rbac.repository.mapper.RbacRoleMapper">

    <select id="lockSuperAdminRoleForUpdate" resultType="com.yomi.boot.java.component.rbac.entity.RbacRole">
        SELECT *
        FROM t_sys_rbac_role
        WHERE code = #{superAdminCode}
          AND delete_time IS NULL
        LIMIT 1
        FOR UPDATE
    </select>

</mapper>
